POSTGRES_DB=callanalytics
POSTGRES_USER=callanalytics
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://callanalytics:change-this-local-password@postgres:5432/callanalytics
REDIS_URL=redis://redis:6379/0
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_TOKEN=
WEBHOOK_SECRET=change-me
MAX_UPLOAD_MB=200
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ERPNext: leave credentials empty while disabled. HTTPS is required by default.
ERPNEXT_ENABLED=false
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_ANALYSIS_ENDPOINT=/api/method/call_analytics_integration.api.receive_call_analysis
ERPNEXT_REQUEST_TIMEOUT=30
ERPNEXT_MAX_RETRIES=5
# Development only: allow a trusted HTTP ERPNext instance.
ERPNEXT_ALLOW_HTTP=false
# Independent, high-entropy Bearer token for integration admin routes.
ERPNEXT_ADMIN_TOKEN=
