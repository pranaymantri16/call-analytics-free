{
  "$defs": {
    "RecordingReference": {
      "additionalProperties": false,
      "properties": {
        "storage_type": {
          "const": "local",
          "default": "local",
          "title": "Storage Type",
          "type": "string"
        },
        "object_key": {
          "default": null,
          "title": "Object Key",
          "type": "null"
        }
      },
      "title": "RecordingReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
