    },
    "direction": {
      "anyOf": [
        {
          "enum": [
            "Inbound",
            "Outbound"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Direction"
    },
    "analysis_status": {
      "const": "Completed",
      "default": "Completed",
      "title": "Analysis Status",
      "type": "string"
    },
    "transcript": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "customer_interest_level": {
      "anyOf": [
        {
          "enum": [
            "High",
            "Medium",
            "Low"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Customer Interest Level"
    },
    "key_topics": {
      "items": {
        "type": "string"
