      "type": "string"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "recording_id": {
      "title": "Recording Id",
      "type": "string"
    },
    "customer_reference": {
      "default": null,
      "title": "Customer Reference",
      "type": "null"
    },
    "lead_reference": {
      "default": null,
      "title": "Lead Reference",
      "type": "null"
    },
    "contact_reference": {
      "default": null,
      "title": "Contact Reference",
      "type": "null"
    },
    "employee_reference": {
      "default": null,
      "title": "Employee Reference",
      "type": "null"
    },
    "call_datetime": {
      "format": "date-time",
      "title": "Call Datetime",
      "type": "string"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
